"""MLP-Attention-LSTM surrogate for BS 8414-1 facade fire tests.

This is the **MLP ablation control** for the KAN-Attention-LSTM champion
(`bs8414_KAN_surrogate/model_v7.KANAttentionLSTMv7`, the class behind models_v9).
The scientific question it answers: does the learnable B-spline edge activation
(KAN) actually buy anything over a conventional MLP once everything else — inputs,
temporal backbone, physics channels, loss, split, ensembling — is held fixed?

Held fixed vs the KAN champion (transplanted verbatim):
  - 39-feature physics-causal input vector + ignition-anchor scalar
  - sinusoidal TimeEncoding, MultiScaleConv (k=3/9/27), 2-layer BiLSTM(96),
    4-head self-attention + LayerNorm, param->sensor skip projection
  - five causal per-timestep channels: delta(t - t_anchor), ignition bump,
    q(t) [MW], Q(t) [cumulative], q(t)^(2/3) [Heskestad plume scaling]
  - hard ambient clamp: out = max(out, (18 degC - mean)/scale) per sensor
  - three grouped sensor decoders (External LV1 / External LV2 / Insulation LV2)

Changed (the one variable):
  - every KANLinear edge block ->  y = LayerNorm(W2 · GELU(W1 x + b1) + b2)

Capacity is MATCHED, not reduced. KANLinear(i, o, K) carries K spline
coefficients per edge plus a SiLU residual; a naive Linear swap would be ~9x
smaller and would confound "KAN vs MLP" with "big vs small". Each MLP block
therefore sizes its hidden width so its parameter count matches the KANLinear it
replaces:

    KANLinear(i, o, K):  o·i·(K+1) + i + 3o
    MLPLinear(i, o, h):  h·(i + o + 1) + 3o
    =>  h = round( (o·i·(K+1) + i) / (i + o + 1) )

Result: 853,099 parameters vs the KAN's 852,795 (+0.04%). Pass
`match_params=False` for the capacity-free variant (h = o, 675,960 params).

Run `python model.py` for the parameter count and a forward-pass shape check.
"""
import math

import numpy as np
import torch
import torch.nn as nn

from config import N_SENSORS, N_TIMESTEPS, T_END
from features_v4 import V4_FEATURES, HRR_MW_SCALE

BUMP_WIDTH = 0.08
T_AMBIENT = 18.0

# column of the normalised hrr_mw feature in the (B, 16+K) params tensor
HRR_MW_COL = 16 + V4_FEATURES.index("hrr_mw")

# Fire_RAMP_Q knots common to every BS8414 simulation (seconds, fraction)
RAMP_KNOTS_T = [0.0, 300.0, 600.0, 706.31, 720.0, 1380.0, 1500.0, 1800.0]
RAMP_KNOTS_F = [0.0, 0.571, 0.95, 0.971, 1.0, 1.0, 0.571, 0.0]


def ramp_curve(n_timesteps=N_TIMESTEPS):
    t = np.linspace(0.0, T_END, n_timesteps)
    return np.interp(t, RAMP_KNOTS_T, RAMP_KNOTS_F).astype(np.float32)


# ──────────────────────────────────────────────────────────────────────
# MLP edge block (the KANLinear stand-in)
# ──────────────────────────────────────────────────────────────────────

def matched_hidden(in_features, out_features, num_knots):
    """Hidden width making MLPLinear match KANLinear(in, out, num_knots) in params."""
    target = out_features * in_features * (num_knots + 1) + in_features
    return max(1, int(round(target / (in_features + out_features + 1))))


class MLPLinear(nn.Module):
    """Conventional MLP block: LayerNorm(W2 · GELU(W1 x + b1) + b2).

    Same interface as the KAN block it replaces — accepts (B, F) or (B, T, F) —
    and keeps the output LayerNorm so training stability is not a confound.
    Fixed GELU on nodes instead of learnable B-splines on edges.
    """

    def __init__(self, in_features, out_features, num_knots=8, match_params=True,
                 hidden=None):
        super().__init__()
        if hidden is None:
            hidden = (matched_hidden(in_features, out_features, num_knots)
                      if match_params else out_features)
        self.in_features = in_features
        self.out_features = out_features
        self.hidden = hidden
        self.fc1 = nn.Linear(in_features, hidden)
        self.act = nn.GELU()
        self.fc2 = nn.Linear(hidden, out_features)
        self.ln = nn.LayerNorm(out_features)

    def forward(self, x):
        return self.ln(self.fc2(self.act(self.fc1(x))))


# ──────────────────────────────────────────────────────────────────────
# Backbone pieces (transplanted unchanged from the KAN project)
# ──────────────────────────────────────────────────────────────────────

class TimeEncoding(nn.Module):
    def __init__(self, d_model):
        super().__init__()
        self.d_model = d_model

    def forward(self, time_array):
        pe = torch.zeros(len(time_array), self.d_model, device=time_array.device)
        pos = time_array.unsqueeze(1) * 1000
        div = torch.exp(torch.arange(0, self.d_model, 2, device=time_array.device).float()
                        * -(math.log(10000.0) / self.d_model))
        pe[:, 0::2] = torch.sin(pos * div)
        pe[:, 1::2] = torch.cos(pos * div)
        return pe


class MultiScaleConv(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.conv3 = nn.Conv1d(in_ch, out_ch // 3, kernel_size=3, padding=1)
        self.conv9 = nn.Conv1d(in_ch, out_ch // 3, kernel_size=9, padding=4)
        self.conv27 = nn.Conv1d(in_ch, out_ch - 2 * (out_ch // 3), kernel_size=27,
                                padding=13)
        self.norm = nn.LayerNorm(out_ch)

    def forward(self, x):
        xt = x.transpose(1, 2)
        return self.norm(torch.cat([self.conv3(xt), self.conv9(xt), self.conv27(xt)],
                                   dim=1).transpose(1, 2))


# ──────────────────────────────────────────────────────────────────────
# MLP encoder / decoders
# ──────────────────────────────────────────────────────────────────────

class MLPParameterEncoder(nn.Module):
    """Cladding embedding + continuous features + anchor scalar -> embedding."""

    def __init__(self, n_cladding=4, cladding_embed_dim=12, n_continuous=38,
                 output_dim=24, num_knots=8, match_params=True):
        super().__init__()
        self.cladding_embedding = nn.Embedding(n_cladding, cladding_embed_dim)
        input_dim = cladding_embed_dim + n_continuous + 1  # +1 anchor scalar
        self.block1 = MLPLinear(input_dim, 48, num_knots=num_knots,
                                match_params=match_params)
        self.block2 = MLPLinear(48, output_dim, num_knots=num_knots,
                                match_params=match_params)
        self.output_dim = output_dim

    def forward(self, params, anchor):
        cladding_idx = params[:, 0].long()
        continuous = params[:, 1:]
        clad_embed = self.cladding_embedding(cladding_idx)
        combined = torch.cat([clad_embed, continuous, anchor.unsqueeze(-1)], dim=-1)
        return self.block2(self.block1(combined))


class MLPSensorDecoder(nn.Module):
    """Per-group sensor decoder (identical shapes and dropout placement to KAN)."""

    def __init__(self, input_dim, n_sensors, num_knots=8, dropout=0.15,
                 match_params=True):
        super().__init__()
        hidden = max(32, n_sensors * 2)
        self.block1 = MLPLinear(input_dim, hidden, num_knots=num_knots,
                                match_params=match_params)
        self.dropout1 = nn.Dropout(dropout)
        self.block2 = MLPLinear(hidden, n_sensors, num_knots=num_knots,
                                match_params=match_params)
        self.dropout2 = nn.Dropout(dropout)

    def forward(self, x):
        return self.block2(self.dropout1(self.block1(self.dropout2(x))))


# ──────────────────────────────────────────────────────────────────────
# Full model
# ──────────────────────────────────────────────────────────────────────

class MLPAttentionLSTM(nn.Module):
    """MLP-Attention-LSTM: KAN champion topology with MLP edge blocks."""

    N_TIME_FEATS = 5  # delta, bump, q(t), Q(t), q(t)^(2/3)

    def __init__(self, n_timesteps=N_TIMESTEPS, n_sensors=N_SENSORS, hidden_size=96,
                 embedding_dim=24, n_heads=4, dropout=0.08, num_knots=8,
                 n_continuous=38, match_params=True):
        super().__init__()

        self.param_encoder = MLPParameterEncoder(
            n_continuous=n_continuous, output_dim=embedding_dim,
            num_knots=num_knots, match_params=match_params)
        self.time_encoding = TimeEncoding(d_model=embedding_dim)

        self.input_proj = nn.Sequential(
            nn.Linear(embedding_dim * 2 + self.N_TIME_FEATS, hidden_size),
            nn.GELU(), nn.Dropout(dropout),
        )

        self.multi_scale = MultiScaleConv(hidden_size, hidden_size)

        self.lstm = nn.LSTM(
            input_size=hidden_size, hidden_size=hidden_size,
            num_layers=2, batch_first=True, bidirectional=True, dropout=dropout,
        )

        lstm_out = hidden_size * 2
        self.attention = nn.MultiheadAttention(
            embed_dim=lstm_out, num_heads=n_heads, dropout=dropout, batch_first=True,
        )
        self.attn_norm = nn.LayerNorm(lstm_out)

        self.decoder_ext_lv1 = MLPSensorDecoder(lstm_out, 8, num_knots=num_knots,
                                                match_params=match_params)
        self.decoder_ext_lv2 = MLPSensorDecoder(lstm_out, 8, num_knots=num_knots,
                                                match_params=match_params)
        # Present only for the 24-channel target. With MLP_SENSORS=external the
        # insulation Level 2 group is not predicted, so its decoder is omitted
        # rather than trained against nothing.
        self.decoder_ins_lv2 = None if n_sensors <= 16 else MLPSensorDecoder(lstm_out, 8, num_knots=num_knots,
                                                match_params=match_params)

        self.skip_proj = nn.Linear(embedding_dim, n_sensors)

        # burner ramp buffers (causal q(t), Q(t) channels)
        f = torch.from_numpy(ramp_curve(n_timesteps))
        self.register_buffer("ramp_f", f)
        cum = torch.cumsum(f, dim=0)
        self.register_buffer("ramp_cum", cum / cum[-1])

        # hard ambient floor, per sensor, in scaled space (set via set_ambient)
        self.register_buffer("ambient_scaled", torch.zeros(n_sensors))

    def set_ambient(self, mean, scale, t_amb=T_AMBIENT):
        """Set the per-sensor ambient floor in scaled space from the fitted scaler."""
        mean_t = torch.as_tensor(mean, dtype=torch.float32)
        scale_t = torch.as_tensor(scale, dtype=torch.float32)
        amb = (t_amb - mean_t) / scale_t
        self.ambient_scaled.copy_(amb.to(self.ambient_scaled.device))

    def forward(self, params, time_array, anchor):
        B, T = params.shape[0], len(time_array)

        param_embed = self.param_encoder(params, anchor)
        time_embed = self.time_encoding(time_array)

        delta = time_array.unsqueeze(0) - anchor.unsqueeze(1)
        bump = torch.exp(-(delta / BUMP_WIDTH) ** 2)

        hrr_mw = params[:, HRR_MW_COL:HRR_MW_COL + 1] * HRR_MW_SCALE
        q = hrr_mw * self.ramp_f.unsqueeze(0)
        Q = hrr_mw * self.ramp_cum.unsqueeze(0)
        q23 = q.clamp(min=0.0) ** (2.0 / 3.0)   # plume DT ~ HRR^(2/3)

        combined = torch.cat([
            param_embed.unsqueeze(1).expand(-1, T, -1),
            time_embed.unsqueeze(0).expand(B, -1, -1),
            delta.unsqueeze(-1),
            bump.unsqueeze(-1),
            q.unsqueeze(-1),
            Q.unsqueeze(-1),
            q23.unsqueeze(-1),
        ], dim=-1)

        x = self.input_proj(combined)
        x = x + self.multi_scale(x)

        lstm_out, _ = self.lstm(x)
        attn_out, attn_w = self.attention(lstm_out, lstm_out, lstm_out)
        features = self.attn_norm(lstm_out + attn_out)

        groups = [self.decoder_ext_lv1(features), self.decoder_ext_lv2(features)]
        if self.decoder_ins_lv2 is not None:
            groups.append(self.decoder_ins_lv2(features))
        preds = torch.cat(groups, dim=-1)

        skip = self.skip_proj(param_embed).unsqueeze(1).expand(-1, T, -1)
        out = preds + skip
        return torch.maximum(out, self.ambient_scaled), attn_w


def count_parameters(model):
    return sum(p.numel() for p in model.parameters() if p.requires_grad)


if __name__ == "__main__":
    from features_v6 import N_V6_FEATURES

    n_cont = 2 + 13 + N_V6_FEATURES
    model = MLPAttentionLSTM(n_continuous=n_cont)
    plain = MLPAttentionLSTM(n_continuous=n_cont, match_params=False)
    print(f"MLP-Attention-LSTM (param-matched): {count_parameters(model):,}")
    print(f"MLP-Attention-LSTM (plain h=out)  : {count_parameters(plain):,}")
    print(f"KAN reference (models_v9)         : 852,795")

    model.set_ambient(np.full(N_SENSORS, 200.0, np.float32),
                      np.full(N_SENSORS, 150.0, np.float32))
    p = torch.rand(4, 16 + N_V6_FEATURES)
    p[:, 0] = torch.randint(0, 4, (4,)).float()
    out, _ = model(p, torch.linspace(0, 1, N_TIMESTEPS), torch.rand(4) * 0.5 + 0.3)
    print(f"Output: {tuple(out.shape)}  min(scaled)={out.min().item():.3f} "
          f"floor={model.ambient_scaled.min().item():.3f}")
