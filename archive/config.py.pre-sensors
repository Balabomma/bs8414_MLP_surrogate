"""Configuration for the BS8414 MLP-Attention-LSTM surrogate (KAN ablation control).

Identical to bs8414_KAN_surrogate/config.py except for the data root: this project
does NOT keep its own copy of the FDS outputs, it reads the KAN project's
`data/training_data` so both surrogates are trained and scored on exactly the same
simulations and the same deterministic hash split. Nothing here may drift from the
KAN config — the whole point of the project is a controlled comparison.
"""
import os

PROJECT_DIR = os.path.dirname(os.path.abspath(__file__))

# ── shared data root: the KAN project's live FDS dataset ──────────────────
KAN_PROJECT_DIR = os.path.join(os.path.dirname(PROJECT_DIR), "bs8414_KAN_surrogate")
DATA_DIR = os.path.join(KAN_PROJECT_DIR, "data")
SIMS_DIR = os.path.join(DATA_DIR, "training_data")
DEVC_DIR = os.path.join(DATA_DIR, "devc_csv")
FDS_DIR = os.path.join(DATA_DIR, "fds_scripts")

OUTPUT_DIR = os.path.join(PROJECT_DIR, "outputs")
MODEL_DIR = os.path.join(PROJECT_DIR, "models_mlp")

# ── split ratios ──────────────────────────────────────────────────────────
# Default (env var unset) is the KAN project's 70/15/15 CHID-hash split — the
# values below are then byte-identical to bs8414_KAN_surrogate/config.py, so the
# ablation contract is unchanged and verify_parity.py still passes.
#
# MLP_SPLIT=80_10_10 selects the alternative ratio for the split-sensitivity
# study. The split is still the same deterministic MD5-of-CHID bucketing, only
# the bucket edges move; nothing else in the pipeline changes. NEVER run
# verify_parity.py with this set — the KAN subprocess would inherit the env var
# but read its own hard-coded 0.70/0.15, giving a false parity failure.
SPLIT_NAME = os.environ.get("MLP_SPLIT", "70_15_15")
_SPLIT_RATIOS = {
    "70_15_15": (0.70, 0.15, 0.15),
    "80_10_10": (0.80, 0.10, 0.10),
}
if SPLIT_NAME not in _SPLIT_RATIOS:
    raise ValueError(f"MLP_SPLIT={SPLIT_NAME!r} unknown; "
                     f"expected one of {sorted(_SPLIT_RATIOS)}")
TRAIN_RATIO, VALID_RATIO, TEST_RATIO = _SPLIT_RATIOS[SPLIT_NAME]
SPLIT_LABEL = SPLIT_NAME.replace("_", "/")      # "70/15/15"

CLADDING_SYSTEMS = {
    "Test_1_PE_PIR": 0, "Test_3_FRPE_PIR": 1,
    "Test_5_LCM_PIR": 2, "Test_7_FRPE_Phenolic": 3,
}
HRR_LEVELS = [1333, 1667, 2000, 2100, 2333]
MESH_SIZES = {"M008": 0.08, "M009": 0.09, "M010": 0.10}

MATERIAL_FEATURES = [
    "core_specific_heat", "core_conductivity", "core_density",
    "core_heat_of_reaction", "core_ref_temperature", "core_is_reactive",
    "ins_specific_heat", "ins_conductivity", "ins_density",
    "ins_heat_of_reaction", "ins_ref_temperature",
    "reac_heat_of_combustion", "reac_soot_yield",
]
N_MATERIAL_FEATURES = len(MATERIAL_FEATURES)
N_INPUT_PARAMS = 3 + N_MATERIAL_FEATURES  # 16

T_END = 1800.0
DT_DEVC = 10.0
N_TIMESTEPS = 181
N_SENSORS = 24

KEY_THERMOCOUPLES = {
    "External_LV2_main02(1029)": "TC 1029 - External LV2 Main",
    "External_LV1_main02(1003)": "TC 1003 - External LV1 Main",
}

DEVICE = "cuda"
